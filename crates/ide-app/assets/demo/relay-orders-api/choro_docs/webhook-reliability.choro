{"version":1,"format":"blocknote","title":"Webhook Reliability","blocks":[{"type":"heading","props":{"level":1},"content":"Webhook Reliability"},{"type":"paragraph","content":"A destination may be slow, unavailable, or accept an event before the client sees the response."},{"type":"heading","props":{"level":2},"content":"Delivery policy"},{"type":"bulletListItem","content":"Sign the exact request body and include an immutable event identifier."},{"type":"bulletListItem","content":"Use bounded exponential backoff for transient failures only."},{"type":"bulletListItem","content":"Treat each destination and event identifier as one idempotent delivery."},{"type":"bulletListItem","content":"Retain attempt history for seven days without retaining secret headers."}]}
