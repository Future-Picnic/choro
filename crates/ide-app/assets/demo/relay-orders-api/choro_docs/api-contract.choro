{"version":1,"format":"blocknote","title":"Relay Orders API Contract","blocks":[{"type":"heading","props":{"level":1},"content":"Orders API Contract"},{"type":"paragraph","content":"Relay accepts an order once, calculates authoritative totals from the catalog, and publishes a durable result for downstream systems."},{"type":"heading","props":{"level":2},"content":"Create order"},{"type":"bulletListItem","content":"Requires customerId, at least one item, and an Idempotency-Key header."},{"type":"bulletListItem","content":"Quantities are positive integers; prices never arrive from the client."},{"type":"bulletListItem","content":"A repeated key returns the original response without a second charge."},{"type":"heading","props":{"level":2},"content":"Errors"},{"type":"paragraph","content":"Validation errors are stable machine-readable codes with a concise human message and correlation identifier."}]}
