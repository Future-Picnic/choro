{"version":1,"format":"blocknote","title":"Northstar Product Brief","blocks":[{"type":"heading","props":{"level":1},"content":"Northstar Client Portal"},{"type":"paragraph","content":"A calm, shared workspace where studio clients can understand progress without asking for another status meeting."},{"type":"heading","props":{"level":2},"content":"Primary outcome"},{"type":"paragraph","content":"A client can open the portal, understand what moved, see what needs a decision, and find the latest files in under two minutes."},{"type":"heading","props":{"level":2},"content":"Principles"},{"type":"bulletListItem","content":"Show progress in client language, not internal production language."},{"type":"bulletListItem","content":"Make pending decisions more prominent than passive history."},{"type":"bulletListItem","content":"Keep billing visible without letting it dominate the relationship."}]}
