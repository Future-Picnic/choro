{"version":1,"format":"blocknote","title":"Client Activation Flow","blocks":[{"type":"heading","props":{"level":1},"content":"Client Activation Flow"},{"type":"paragraph","content":"The first session should establish trust before asking the client to configure anything."},{"type":"heading","props":{"level":2},"content":"Journey"},{"type":"numberedListItem","content":"Open the invitation and confirm the studio and project names."},{"type":"numberedListItem","content":"Review the current milestone and the two most recent updates."},{"type":"numberedListItem","content":"Leave one piece of feedback on a prepared design."},{"type":"numberedListItem","content":"Choose a weekly summary preference."},{"type":"heading","props":{"level":2},"content":"Success"},{"type":"paragraph","content":"The client reaches the overview with one completed action and no unresolved setup step."}]}
