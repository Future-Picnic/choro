{"version":1,"format":"blocknote","title":"Momentum Mobile Brief","blocks":[{"type":"heading","props":{"level":1},"content":"Momentum Habit Tracker"},{"type":"paragraph","content":"Momentum helps people notice a sustainable rhythm without turning every missed day into failure."},{"type":"heading","props":{"level":2},"content":"Core loop"},{"type":"numberedListItem","content":"See today's small set of habits."},{"type":"numberedListItem","content":"Mark a habit complete with one comfortable tap."},{"type":"numberedListItem","content":"Review the week as a pattern, not a score."},{"type":"heading","props":{"level":2},"content":"Non-goals"},{"type":"bulletListItem","content":"No public leaderboards or competitive streaks."},{"type":"bulletListItem","content":"No medical, diagnostic, or prescriptive language."}]}
