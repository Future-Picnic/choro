{"version":1,"format":"blocknote","title":"Offline Behavior","blocks":[{"type":"heading","props":{"level":1},"content":"Offline Behavior"},{"type":"paragraph","content":"Daily completion must remain instant and trustworthy without a connection."},{"type":"heading","props":{"level":2},"content":"Rules"},{"type":"bulletListItem","content":"Write completion locally before attempting synchronization."},{"type":"bulletListItem","content":"Use a stable operation identifier so retries cannot duplicate completion events."},{"type":"bulletListItem","content":"Show a quiet pending-sync indicator only after five seconds offline."},{"type":"bulletListItem","content":"Resolve conflicting edits by the latest explicit user action, not device time alone."}]}
