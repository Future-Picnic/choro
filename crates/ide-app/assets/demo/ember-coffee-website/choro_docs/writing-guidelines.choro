{"version":1,"format":"blocknote","title":"Ember Writing Guidelines","blocks":[{"type":"heading","props":{"level":1},"content":"Writing at Ember"},{"type":"paragraph","content":"Warm, sensory, and direct. The reader should feel welcomed, never sold to."},{"type":"heading","props":{"level":2},"content":"Use"},{"type":"bulletListItem","content":"Specific ingredients, places, and moments."},{"type":"bulletListItem","content":"Short sentences with room to breathe."},{"type":"heading","props":{"level":2},"content":"Avoid"},{"type":"bulletListItem","content":"Coffee jargon without an explanation."},{"type":"bulletListItem","content":"Perfect, premium, elevated, or unforgettable."}]}
