{"version":1,"format":"blocknote","title":"Ember Summer Launch","blocks":[{"type":"heading","props":{"level":1},"content":"Ember Summer Launch"},{"type":"paragraph","content":"Refresh the site around the summer blend while keeping the shop—not the campaign—as the main character."},{"type":"heading","props":{"level":2},"content":"Messages"},{"type":"bulletListItem","content":"A slower cup for a fuller day."},{"type":"bulletListItem","content":"Roasted in small batches and poured with care."},{"type":"bulletListItem","content":"Two neighborhood shops, seven days a week."},{"type":"heading","props":{"level":2},"content":"Deliverables"},{"type":"numberedListItem","content":"Summer hero and featured coffee story."},{"type":"numberedListItem","content":"Updated menu and opening hours."},{"type":"numberedListItem","content":"One customer story that feels specific and local."}]}
